# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crazydb
DB_USER=root
DB_PASSWORD=

# Redis (cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=redis.password

# Mail (symfony/mailer DSN, e.g. smtp://user:pass@smtp.example.com:587)
# MAILER_DSN=null://null
# MAILER_DEBUG=true

# Captcha bypass (dev only)
# CAPTCHA_DEBUG=true

