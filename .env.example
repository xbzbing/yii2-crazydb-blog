# ============================================================
# CrazyDB Blog 环境配置
# 复制本文件为 .env 并填写必要配置
# 生产环境请确保 APP_ENV=prod, APP_DEBUG=false
# ============================================================

# --- 应用 ---
APP_ENV=prod
APP_DEBUG=false
# COOKIE_SECURE=false    # HTTPS 部署时设为 true

# --- 数据库（必填） ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crazydb
DB_USER=root
DB_PASSWORD=             # ← 必须填写
DB_TABLE_PREFIX=blog_    # 表前缀（Yii2 遗留），无前缀可留空

# --- Redis（必填） ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=          # ← 必须填写

# --- Nginx 端口 ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- 数据库外部访问端口（默认仅绑定 127.0.0.1，如需远程访问请修改） ---
# DB_PORT_EXPOSE=127.0.0.1:3306
# REDIS_PORT_EXPOSE=127.0.0.1:6379

# --- 邮件（可选，默认不发送） ---
# MAILER_DSN=smtp://user:pass@smtp.example.com:587

# --- 验证码调试（仅开发环境启用） ---
# CAPTCHA_DEBUG=true

# --- Docker 部署路径（仅 docker-compose-deploy.yml 使用） ---
# APP_SRC_DIR=/path/to/yii-crazydb-blog          # 源码目录（deploy/、config/ 等）
# DEPLOY_DATA_DIR=/path/to/persistent/data       # 持久化数据（mysql、redis、日志、ssl 等）
