# phpstorm project files
.idea

# netbeans project files
nbproject

# zend studio for eclipse project files
.buildpath
.project
.settings

# sublime text project / workspace files
*.sublime-project
*.sublime-workspace

# windows thumbnail cache
Thumbs.db

# Mac DS_Store Files
.DS_Store

# composer vendor dir
/vendor

# Codeception C3
c3.php

# Local environment configuration
.env

# legacy (Yii2 era) entries preserved
composer.phar
phpunit.phar
*-local.php
web/ugc
online

# runtime caches generated by tests / avatar downloads (用户头像，非代码)
public/static/avatar

# graphify knowledge graph output
/graphify-out

# playwright-mcp snapshots
.playwright-mcp/

# phpunit cache
.phpunit.cache/
public/static/upload/

# 旧站上传图片目录（Yii2 遗留 /upload/ 路径，与 static/upload 并存）
public/upload/

# admin SPA (Vite/React/antd) build artifacts
admin-web/node_modules/
public/admin/
public/package.json

# pnpm 本地产物（npm/pnpm 都可跑构建，但锁文件以 package-lock.json 为准；pnpm 运行时重建的这两个文件不入库）
admin-web/pnpm-lock.yaml
admin-web/pnpm-workspace.yaml

# vision toolkit 截图/裁剪等运行时产物
/.dsh-vision-toolkit/

# local documentation (not tracked in git)
/docs/local/

# Claude 工具运行时目录（嵌套 git 仓库，不入库）
/.claude/

# 手动放到 public 供下载的目录/文件（Switch 自制程序 nro、旧站资源等，非项目源码）
/public/download/
/public/xbzbing/
/public/wp-content/

# public/static 兜底白名单：默认整目录不入库，只放行项目静态资源子目录，
# 防止杂散文件混进来（下载物已统一挪到上面的 /public/download）。
# 新增项目资源请建子目录并在下面加一行 !。
/public/static/*
!/public/static/fonts/
!/public/static/images/
!/public/static/vditor/
